# ---------------------------------------------------------------------------
# IdeaMarket Africa — variables d'environnement
# Copiez ce fichier en .env.local et renseignez vos valeurs.
# ---------------------------------------------------------------------------

# --- Base de donnees (obligatoire) ---
# Supabase : Project Settings > Database > Connection string (URI, pooler).
DATABASE_URL="postgresql://user:password@host:5432/ideamarket?schema=public"

# --- Authentification (obligatoire) ---
# Generer un secret : openssl rand -base64 32
AUTH_SECRET="remplacez-moi-par-un-secret-de-32-caracteres-minimum"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google OAuth (optionnel) ---
# Sans ces valeurs, seule la connexion email / mot de passe est proposee.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- IA Anthropic (optionnel mais recommande) ---
# Sans cle, l'evaluation, la similarite, le teaser et la moderation basculent
# sur leurs implementations de repli deterministes.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- Supabase Storage et Realtime (optionnel) ---
# Sans ces valeurs : pas de televersement de fichiers, et le temps reel
# bascule sur un rafraichissement periodique.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="ideamarket"

# --- Stripe (optionnel) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Mobile Money (stubs — voir src/lib/payments/mobile-money.ts) ---
WAVE_API_KEY=""
ORANGE_MONEY_API_KEY=""
MTN_MOMO_API_KEY=""

# --- Emails transactionnels (optionnel) ---
RESEND_API_KEY=""
EMAIL_FROM="IdeaMarket Africa <no-reply@ideamarket.africa>"

# --- Reglages plateforme ---
# Commission prelevee a la vente, en pourcentage.
PLATFORM_FEE_PERCENT="10"
# Secret protegeant /api/cron/close-auctions (en-tete Authorization: Bearer ...).
CRON_SECRET=""
