# ===========================================================================
# IdeaMarket Africa — variables d'environnement
#
# Local      : copiez ce fichier en `.env.local` et renseignez les valeurs.
# Vercel     : Project Settings > Environment Variables (Production/Preview).
#
# Seules DATABASE_URL et AUTH_SECRET sont obligatoires pour demarrer.
# Chaque integration absente bascule sur un mode degrade documente dans le
# README ; aucune ne bloque le demarrage de l'application.
# ===========================================================================

# --- Base de donnees (OBLIGATOIRE) -----------------------------------------

# Connexion applicative, utilisee par l'application a l'execution.
# Supabase > Project Settings > Database > Connection string > "Transaction"
# (pooler, port 6543). Ajoutez `?pgbouncer=true&connection_limit=1` en
# serverless : chaque fonction Vercel ouvre sa propre connexion.
DATABASE_URL=""

# Connexion DIRECTE (port 5432, sans pooler), utilisee uniquement par
# `prisma migrate deploy` et `prisma db push` — declaree via `directUrl` dans
# prisma/schema.prisma. Les migrations ouvrent des transactions longues et des
# verrous consultatifs que le pooler en mode transaction ne supporte pas.
# Sans cette variable l'application fonctionne, mais les migrations echouent.
DIRECT_URL=""

# --- Authentification (OBLIGATOIRE) ----------------------------------------

# ATTENTION AU NOM : ce projet utilise NextAuth v5 (Auth.js), dont les
# variables s'appellent AUTH_SECRET et AUTH_URL — et non NEXTAUTH_SECRET /
# NEXTAUTH_URL, qui etaient les noms de la v4. Ce sont bien les deux variables
# ci-dessous que le code lit (src/lib/env.ts) : definir NEXTAUTH_SECRET seul
# fait echouer le demarrage en production.
#
# Generer le secret :  openssl rand -base64 32
AUTH_SECRET=""

# URL publique de l'application. En production, l'URL du projet Vercel
# (https://votre-projet.vercel.app ou votre domaine personnalise).
AUTH_URL=""

# Meme URL, exposee au navigateur (liens des emails, redirections Stripe).
NEXT_PUBLIC_APP_URL=""

# --- IA : evaluation, similarite, teaser, moderation -----------------------

# Cle API Anthropic. Absente : l'evaluation bascule sur un score heuristique
# (plafonne a 72), la similarite sur une comparaison lexicale, le teaser sur
# l'accroche du vendeur, et la moderation sur ses regles deterministes seules.
ANTHROPIC_API_KEY=""

# Modele utilise pour l'evaluation et la moderation.
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- Paiements Stripe ------------------------------------------------------

# Cle secrete Stripe (sk_live_... ou sk_test_...). Absente : le paiement par
# carte est masque dans l'interface ; Mobile Money et portefeuille restent
# disponibles.
STRIPE_SECRET_KEY=""

# Secret de signature du webhook (whsec_...), obtenu en declarant le endpoint
# https://votre-domaine/api/webhooks/stripe pour les evenements
# checkout.session.completed, checkout.session.expired et
# payment_intent.payment_failed. Sans lui, les paiements carte ne sont jamais
# confirmes cote plateforme.
STRIPE_WEBHOOK_SECRET=""

# Cle publiable, exposee au navigateur.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Emails transactionnels ------------------------------------------------

# Cle API Resend. Absente : les emails sont journalises sans etre envoyes ;
# les notifications dans l'application continuent de fonctionner.
RESEND_API_KEY=""

# Expediteur des emails. Le domaine doit etre verifie dans Resend.
EMAIL_FROM="IdeaMarket Africa <no-reply@ideamarket.africa>"

# ===========================================================================
# Variables optionnelles
# ===========================================================================

# --- Google OAuth ----------------------------------------------------------
# Absentes : seule la connexion email / mot de passe est proposee.
# URL de rappel a declarer : https://votre-domaine/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Supabase Storage et Realtime ------------------------------------------
# Absentes : pas de televersement de fichiers, contrats PDF regeneres a la
# demande, et le temps reel bascule sur un rafraichissement periodique.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="ideamarket"

# --- Mobile Money ----------------------------------------------------------
# Integrations de substitution (stubs) : voir src/lib/payments/mobile-money.ts.
# Ces cles servent aussi a verifier la signature du webhook operateur.
WAVE_API_KEY=""
ORANGE_MONEY_API_KEY=""
MTN_MOMO_API_KEY=""

# --- Reglages plateforme ---------------------------------------------------

# Commission prelevee sur chaque vente, en pourcentage (defaut : 10).
PLATFORM_FEE_PERCENT="10"

# Protege /api/cron/close-auctions (en-tete `Authorization: Bearer <valeur>`).
# Vercel injecte automatiquement cet en-tete pour les crons declares dans
# vercel.json. Sans valeur, l'endpoint est accessible sans authentification.
CRON_SECRET=""
