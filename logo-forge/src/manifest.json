{
  "manifestVersion": 5,
  "id": "com.logoforge.illustrator",
  "name": "Logo Forge",
  "version": "0.1.0",
  "main": "index.html",
  "host": [
    {
      "app": "ILST",
      "minVersion": "25.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "logoForgePanel",
      "label": {
        "default": "Logo Forge",
        "fr": "Logo Forge"
      },
      "minimumSize": { "width": 320, "height": 420 },
      "maximumSize": { "width": 1400, "height": 2000 },
      "preferredDockedSize": { "width": 380, "height": 720 },
      "preferredFloatingSize": { "width": 520, "height": 780 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-light.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-dark.png",
          "scale": [1, 2],
          "theme": ["dark", "darkest"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [1, 2],
      "theme": ["light", "dark", "darkest", "lightest"],
      "species": ["pluginList"]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "read",
    "allowCodeGenerationFromStrings": false,
    "enableAddon": false
  }
}
